# Copy to .env.local. These values are read only on the server.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_KEY
# Match the exact browser origin (no trailing slash). Change for Vercel later.
APP_ORIGIN=http://127.0.0.1:3000
# Keep false for the restricted MVP. Also disable signup in Supabase; no app signup endpoint exists.
AUTH_ALLOW_SIGNUP=false

# Optional, ONLY for npm run test:integration against a dedicated dev project.
# Two existing, confirmed test users with passwords set via the Supabase dashboard.
# SUPABASE_TEST_USER_A_EMAIL=
# SUPABASE_TEST_USER_A_PASSWORD=
# SUPABASE_TEST_USER_B_EMAIL=
# SUPABASE_TEST_USER_B_PASSWORD=
